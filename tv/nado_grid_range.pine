//@version=6
indicator("Nado 网格区间", overlay = true)

strategyId = input.string("", "策略 ID")
webhookSecret = input.string("", "Webhook 密钥")
marketOverride = input.string("", "市场覆盖")
nonce = input.string("1", "Nonce")
sendSignal = input.bool(false, "发送")

upper = input.price(110000.0, "区间上限", confirm = true)
lower = input.price(90000.0, "区间下限", confirm = true)

upperPlot = plot(upper, "区间上限", color = color.new(color.red, 0), linewidth = 2)
lowerPlot = plot(lower, "区间下限", color = color.new(color.green, 0), linewidth = 2)
fill(upperPlot, lowerPlot, color = color.new(color.blue, 92))

var string lastNonce = ""
symbol = marketOverride != "" ? marketOverride : syminfo.ticker
isReady = strategyId != "" and webhookSecret != "" and symbol != "" and upper > lower
shouldSend = barstate.islast and sendSignal and isReady and nonce != lastNonce

if shouldSend
    message = "{" +
      "\"strategyId\":\"" + strategyId + "\"," +
      "\"nonce\":\"" + nonce + "\"," +
      "\"symbol\":\"" + symbol + "\"," +
      "\"upper\":" + str.tostring(upper) + "," +
      "\"lower\":" + str.tostring(lower) + "," +
      "\"timestamp\":" + str.tostring(timenow) + "," +
      "\"secret\":\"" + webhookSecret + "\"" +
      "}"
    alert(message, alert.freq_once_per_bar_close)
    lastNonce := nonce
