NODE_ENV=development
HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=https://grid.example.com
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-32-byte-random-secret
TRADINGVIEW_WEBHOOK_SECRET=replace-with-tv-secret
DB_PATH=./data/nado-grid.sqlite

# Nado defaults. Live trading remains blocked unless LIVE_TRADING_ENABLED=true.
NADO_NETWORK=mainnet
NADO_CHAIN_ENV=inkMainnet
NADO_PRIVATE_KEY=
NADO_SUBACCOUNT=default
LIVE_TRADING_ENABLED=false
